# Copy this file to .env and change the values before running THEA.

# Dashboard login (single admin user)
THEA_ADMIN_USERNAME=admin
THEA_ADMIN_PASSWORD=change-me-now

# Signing key for login tokens. If unset, one is generated in data/secret.key
# THEA_SECRET_KEY=replace-with-a-long-random-string

# Camera config file (YAML). Relative paths are resolved from the project root.
# THEA_CAMERAS_FILE=config/cameras.yaml

# Where the SQLite DB, snapshots and enrolled photos are stored.
# THEA_DATA_DIR=data

# Matching / alert tuning
THEA_MATCH_THRESHOLD=0.45
THEA_CONSECUTIVE_FRAMES=3
THEA_ALERT_COOLDOWN_SECONDS=60
THEA_PATH_WINDOW_SECONDS=120
THEA_TARGET_FPS=4

# Initial engine before an admin selection is saved (auto, insightface, or mock)
THEA_FACE_ENGINE=auto
THEA_INSIGHTFACE_MODEL=buffalo_l

# Allow the Vite dev server to call the API
THEA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Netscape-format YouTube cookies for cloud/datacenter deployments.
# On Render, upload a Secret File named youtube-cookies.txt and set:
# THEA_YTDLP_COOKIES_FILE=/etc/secrets/youtube-cookies.txt

# Media stream refresh rate (MJPEG)
THEA_STREAM_FPS=30

# Watchlist enrollment accepts 1 photo by default (auto-resampled)
# THEA_MIN_WATCHLIST_PHOTOS=1
# THEA_MAX_WATCHLIST_PHOTOS=1
